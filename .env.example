# Sovra Verify — environment template.
#
# Copy this file to .env for local use, or export the variables yourself:
#
#     cp .env.example .env
#     # edit .env and paste YOUR OWN credentials
#     export CSCS_INFERENCE_API_KEY="..."
#     make run
#
# Every value below is an empty placeholder. There is no working credential of
# any kind in this file, and there must never be one.
#
# Judges must use their own credentials, or run a documented local inference
# endpoint. The developer's key is not shipped with this project.
#
# NEVER copy the personal credential file (~/.hermes/.env on the build host)
# into this repository, into an image layer, into a container, into a log, into
# a screenshot, or into a model prompt. Read only the entries you need, by name.

# ---------------------------------------------------------------------------
# Required: the primary provider credential.
# ---------------------------------------------------------------------------
# CSCS-hosted Apertus inference, OpenAI-compatible, bearer authentication.
# Set this to your own key.
CSCS_INFERENCE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: the backup provider credential.
# ---------------------------------------------------------------------------
# Setting this does NOT enable the backup provider. It stays disabled until both
# SOVRA_BACKUP_ENABLED=1 and SOVRA_ALLOW_BACKUP_FALLBACK=1 are set, because the
# Hugging Face router does not serve Apertus 1.5 70B for this model family and a
# fallback would therefore change the model that produced a finding.
HUGGING_FACE_API_KEY=

# ---------------------------------------------------------------------------
# Application configuration
# ---------------------------------------------------------------------------

# Default model. Apertus 1.5 70B. Leave as-is unless you deliberately choose
# another model; the application never downgrades this silently.
SOVRA_MODEL=swiss-ai/Apertus-v1.5-70B

# Primary provider endpoint.
SOVRA_CSCS_BASE_URL=https://api.inference.cscs.ch/v1

# Backup provider (opt-in, and note the model limitation above).
SOVRA_BACKUP_MODEL=swiss-ai/Apertus-8B-Instruct-2509
SOVRA_BACKUP_ENABLED=0
SOVRA_ALLOW_BACKUP_FALLBACK=0

# Optional 8B model. Only switch this on if you deliberately want the smaller
# model; the application refuses to select an 8B model while this is 0.
SOVRA_ALLOW_OPTIONAL_8B=0

# Request limits.
SOVRA_TIMEOUT_SECONDS=180
SOVRA_MAX_OUTPUT_TOKENS=2048
SOVRA_MAX_RETRIES=2
SOVRA_MAX_DOCUMENTS=10
SOVRA_MAX_UPLOAD_BYTES=10485760
SOVRA_MAX_EXTRACTED_CHARS=400000
SOVRA_MAX_COMPARE_PAIRS=60
SOVRA_MAX_CHUNK_CHARS=3500

# Storage. Point this anywhere writable by the process.
SOVRA_WORK_DIR=.sovra_work
SOVRA_DATA_DIR=track_2b/data

# ---------------------------------------------------------------------------
# Local / on-premise inference endpoint (architecture option, not a verified
# deployment). Leave disabled until you have actually run it.
# ---------------------------------------------------------------------------
SOVRA_LOCAL_ENABLED=0
SOVRA_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
SOVRA_LOCAL_MODEL=swiss-ai/Apertus-v1.5-70B
SOVRA_LOCAL_API_KEY=

# Set to 0 to stop the application from reading a host credential file at all.
# Containers should always run with this set to 0 and use injected variables.
SOVRA_READ_HERMES_ENV=0

# Prompt contents are not logged by default. Turning this on writes untrusted
# document text into the log, so only enable it deliberately.
SOVRA_LOG_PROMPT_CONTENTS=0

# Host port published by compose.
SOVRA_HOST_PORT=8080
